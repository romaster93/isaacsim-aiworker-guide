Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Unknown1
        - /Unknown1/Topic1
        - /Value Map1
        - /Value Map1/Topic1
        - /Depth1
      Splitter Ratio: 0.5
    Tree Height: 70
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
